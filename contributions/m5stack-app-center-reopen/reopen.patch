+
+bool Hal::canDownloadApp(const app_center::AppInfo_t& app)
+{
+#if CONFIG_STACKCHAN_APP_CENTER_REOPEN
+    if (!app.reopenImageSha256.empty()) {
+        return !app.firmwareUrl.empty() && app_center::availableInactiveAppSlot() != nullptr;
+    }
+#endif
+    return !app.firmwareUrl.empty();
+}
+
+bool Hal::canOpenInstalledApp(const app_center::AppInfo_t& app)
+{
+#if CONFIG_STACKCHAN_APP_CENTER_REOPEN
+    return app_center::installedAppToReopen(app.reopenImageSha256) != nullptr;
+#else
+    (void)app;
+    return false;
+#endif
+}
+
+void Hal::openInstalledApp(const app_center::AppInfo_t& app)
+{
+#if CONFIG_STACKCHAN_APP_CENTER_REOPEN
+    if (app_center::selectInstalledApp(app.reopenImageSha256)) {
+        esp_restart();
+    }
+#else
+    (void)app;
+#endif
 }
