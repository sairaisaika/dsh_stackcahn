CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# Match the public receiver's task stack budget while running image checks and NVS.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# Use the SDK software SHA implementation for repeatable QEMU runs.
# The public receiver retains the normal hardware-accelerated SDK setting.
# CONFIG_MBEDTLS_HARDWARE_SHA is not set
