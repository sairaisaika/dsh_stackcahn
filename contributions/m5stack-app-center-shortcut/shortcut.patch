@@ -0,0 +1,58 @@
+// SPDX-License-Identifier: MIT
+#include "sdkconfig.h"
+#if CONFIG_STACKCHAN_DSH_APP_CENTER_SHORTCUT
+#include "app_dsh_shortcut.h"
+#include <apps/common/home_indicator/home_indicator.h>
+#include <esp_system.h>
+#include <hal/app_center_dsh_shortcut.h>
+#include <hal/hal.h>
+
+AppDshShortcut::AppDshShortcut()
+{
+    setAppInfo().name = "DSH.AGENT";
+    static uint32_t color = 0x538BD7;
+    setAppInfo().userData = &color;
+}
+
+void AppDshShortcut::onOpen()
+{
+    LvglLockGuard lock;
+    page_ = lv_obj_create(lv_screen_active());
+    lv_obj_set_size(page_, LV_PCT(100), LV_PCT(100));
+    status_ = lv_label_create(page_);
+    lv_label_set_long_mode(status_, LV_LABEL_LONG_WRAP);
+    lv_obj_set_width(status_, LV_PCT(90));
+    lv_label_set_text(status_, "Checking DSH.AGENT...");
+    lv_obj_center(status_);
+    view::create_home_indicator([this] { close(); }, 0xB8D3FD, 0x26206A, page_);
+    open_pending_ = true;
+}
+
+void AppDshShortcut::onRunning()
+{
+    const char* message = nullptr;
+    if (open_pending_) {
+        open_pending_ = false;
+        // Run on the application task outside the display lock.
+        using app_center::DshShortcutResult;
+        switch (app_center::selectDshShortcut()) {
+        case DshShortcutResult::Selected: esp_restart();
+        case DshShortcutResult::SetupRequired: message = "Open or install DSH.AGENT in App Center first."; break;
+        case DshShortcutResult::UpdateInProgress: message = "Finish any system update before opening DSH.AGENT."; break;
+        case DshShortcutResult::ImageUnavailable: message = "DSH.AGENT is unavailable. Check App Center."; break;
+        }
+    }
+    LvglLockGuard lock;
+    if (message) lv_label_set_text(status_, message);
+    view::update_home_indicator();
+}
+
+void AppDshShortcut::onClose()
+{
+    LvglLockGuard lock;
+    open_pending_ = false;
+    view::destroy_home_indicator();
+    if (page_) lv_obj_delete(page_);
+    page_ = status_ = nullptr;
+}
+#endif
