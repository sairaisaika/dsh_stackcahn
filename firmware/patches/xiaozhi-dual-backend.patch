+void Application::ScheduleProtocolTask(uint64_t epoch, std::function<void()> task) {
+    if (epoch != protocol_epoch_.load())
+        return;
+    if (xTaskGetCurrentTaskHandle() == main_task_handle_) {
+        if (sion_transition_) {
+            if (deferred_protocol_tasks_.size() < 32)
+                deferred_protocol_tasks_.push_back([this, epoch, task = std::move(task)]() mutable {
