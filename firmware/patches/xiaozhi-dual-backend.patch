+bool Application::SionCanEnter() const {
+    auto state = GetDeviceState();
+    return !sion_transition_ && !sion_job_running_.load() && protocol_ &&
+           (state == kDeviceStateIdle || state == kDeviceStateListening ||
+            state == kDeviceStateSpeaking);
+}
+void Application::SionQuiesce(uint64_t epoch) {
+    protocol_epoch_.store(epoch);
+    sion_transition_ = true;
+    deferred_protocol_tasks_.clear();
+    pending_listening_start_ = false;
+    play_popup_on_listening_ = false;
+    if (GetDeviceState() == kDeviceStateNotifying)
+        StopNotification();
+    audio_service_.BeginBackendHandoff();
+    xEventGroupClearBits(event_group_, MAIN_EVENT_SEND_AUDIO | MAIN_EVENT_WAKE_WORD_DETECTED |
+                                           MAIN_EVENT_ERROR | MAIN_EVENT_PLAYBACK_DRAINED);
+    SetDeviceState(kDeviceStateIdle);
+    Board::GetInstance().GetDisplay()->SetStatus("Switching assistant...");
+}
+bool Application::SionIsQuiescent() {
+    if (sion_job_running_.load() || !audio_service_.IsBackendHandoffQuiescent())
+        return false;
+    // Network close/destruction can wait for SDK tasks. Keep it off the main
+    // loop so physical return and lease processing stay responsive.
+    if (protocol_) {
+        protocol_->PrepareForHandoff();
+        sion_job_running_.store(true);
+        if (xTaskCreate(
+                [](void* arg) {
+                    auto* app = static_cast<Application*>(arg);
+                    app->protocol_->CloseAudioChannel();
+                    app->protocol_.reset();
+                    app->sion_job_running_.store(false);
+                    app->Schedule([] {});
+                    vTaskDelete(nullptr);
+                },
+                "sion_close", 8192, this, 2, nullptr) != pdPASS)
+            sion_job_running_.store(false);
+        return false;
+    }
+    return true;
+}
+void Application::SionConnect(bool local, uint64_t epoch, const std::string& url,
+                              const std::string& token) {
+    if (local)
+        protocol_ = std::make_unique<WebsocketProtocol>(
+            WebsocketEndpoint{url, token, 1, sion::BackendRuntime::Get().LocalNetwork()});
+    else if (factory_uses_mqtt_)
+        protocol_ = std::make_unique<MqttProtocol>();
+    else
+        protocol_ = std::make_unique<WebsocketProtocol>();
+    sion_job_epoch_ = epoch;
+    sion_job_result_.store(0);
+    BindProtocolCallbacks();
+    sion_job_running_.store(true);
+    // Blocking socket/hello operations run away from main/audio tasks. No other caller
+    // may touch protocol_ until this worker reports completion.
+    if (xTaskCreate(
+            [](void* arg) {
+                auto* app = static_cast<Application*>(arg);
+                bool ready = app->protocol_->Start() && app->protocol_->OpenAudioChannel();
+                int pending = 0;
+                app->sion_job_result_.compare_exchange_strong(pending, ready ? 1 : 2);
+                app->sion_job_running_.store(false);
+                app->Schedule([] {});
+                vTaskDelete(nullptr);
+            },
+            "sion_connect", 8192, this, 2, nullptr) != pdPASS) {
+        sion_job_result_.store(2);
+        sion_job_running_.store(false);
+    }
+}
+sion::Result Application::SionConnectionResult(uint64_t epoch) {
+    if (epoch != sion_job_epoch_ || sion_job_running_.load())
+        return sion::Result::Pending;
+    return sion_job_result_.load() == 1 ? sion::Result::Ready : sion::Result::Failed;
+}
+bool Application::SionActivate(bool local, uint64_t epoch) {
+    if (epoch != protocol_epoch_.load())
+        return false;
+    sion_transition_ = false;
+    audio_service_.EndBackendHandoff();
+    last_error_message_.clear();
+    SetDeviceState(kDeviceStateIdle);
+    // Explicitly restore wake processing even when state was already idle.
+    HandleStateChangedEvent();
+    if (local) {
+        listening_mode_ = kListeningModeRealtime;
+        SetDeviceState(kDeviceStateListening);
+        HandleStateChangedEvent();
+    }
+    auto pending = std::move(deferred_protocol_tasks_);
+    for (auto& task : pending)
+        task();
+    // A close/error may have been deferred during the handshake. Replaying it
+    // must not turn a disconnected original backend into a ready receipt.
+    if (epoch != protocol_epoch_.load() || !protocol_ || !protocol_->IsAudioChannelOpened())
+        return false;
+    return local ? audio_service_.IsAudioProcessorRunning() : audio_service_.IsWakeWordRunning();
+}
