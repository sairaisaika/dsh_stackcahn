diff --git a/firmware/main/hal/app_center_dsh_shortcut.h b/firmware/main/hal/app_center_dsh_shortcut.h
new file mode 100644
index 0000000..2e2d348
--- /dev/null
+++ b/firmware/main/hal/app_center_dsh_shortcut.h
@@ -0,0 +1,112 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+
+#include "app_center_reopen.h"
+#include "sdkconfig.h"
+#include <algorithm>
+#include <cstring>
+#include <esp_image_format.h>
+#include <esp_log.h>
+#include <memory>
+#include <new>
+#include <psa/crypto.h>
+#include <nvs.h>
+
+static_assert(CONFIG_STACKCHAN_DSH_CATALOG_ID > 0, "Configure the publisher's DSH catalog item ID");
+
+namespace app_center {
+
+struct DshShortcutRecord {
+    ImageDigest factory;
+    std::array<char, 64> agent;
+};
+static_assert(sizeof(DshShortcutRecord) == 96);
+inline constexpr char dsh_shortcut_namespace[] = "app_dsh_menu";
+inline constexpr char dsh_shortcut_key[] = "launch_v1";
+
+// Stream the running image without remapping its executable Flash pages.
+// The digest must match the image trailer before it can identify the factory build.
+inline bool readRunningImageDigest(const esp_partition_t& partition, ImageDigest& digest)
+{
+    const esp_partition_pos_t position{.offset = partition.address, .size = partition.size};
+    esp_image_metadata_t image{};
+    if (esp_image_get_metadata(&position, &image) != ESP_OK || !image.image.hash_appended ||
+        image.image_len <= digest.size() || image.image_len > partition.size) return false;
+
+    constexpr size_t chunk_size = 4096;
+    std::unique_ptr<uint8_t[]> chunk(new (std::nothrow) uint8_t[chunk_size]);
+    if (!chunk) return false;
+    auto hash = psa_hash_operation_init();
+    if (psa_hash_setup(&hash, PSA_ALG_SHA_256) != PSA_SUCCESS) return false;
+    const size_t size = image.image_len - digest.size();
+    for (size_t offset = 0; offset < size;) {
+        const auto length = std::min(chunk_size, size - offset);
+        if (esp_partition_read(&partition, offset, chunk.get(), length) != ESP_OK ||
+            psa_hash_update(&hash, chunk.get(), length) != PSA_SUCCESS) {
+            psa_hash_abort(&hash);
+            return false;
+        }
+        offset += length;
+    }
+    size_t written = 0;
+    const auto status = psa_hash_finish(&hash, digest.data(), digest.size(), &written);
+    if (status != PSA_SUCCESS) psa_hash_abort(&hash);
+    return status == PSA_SUCCESS && written == digest.size() &&
+           std::memcmp(digest.data(), image.image_digest, digest.size()) == 0;
+}
+
+// Called only after a user-selected catalog download or Open has selected the next boot.
+inline void rememberDshShortcut(std::string_view advertised)
+{
+    const auto expected = parseReopenDigest(advertised);
+    const auto* running = esp_ota_get_running_partition();
+    const auto* target = esp_ota_get_boot_partition();
+    if (!expected || !running || !target || target == running || esp_ota_get_app_partition_count() != 2 ||
+        target != esp_ota_get_next_update_partition(running)) return;
+
+    esp_ota_img_states_t state;
+    if (esp_ota_get_state_partition(running, &state) != ESP_OK || state != ESP_OTA_IMG_VALID ||
+        esp_ota_get_state_partition(target, &state) != ESP_OK || state != ESP_OTA_IMG_NEW) return;
+
+    DshShortcutRecord record;
+    ImageDigest actual;
+    esp_app_desc_t app{};
+    if (esp_partition_get_sha256(target, actual.data()) != ESP_OK || actual != *expected ||
+        esp_ota_get_partition_description(target, &app) != ESP_OK ||
+        std::strncmp(app.project_name, "stack-chan", sizeof(app.project_name)) != 0 ||
+        std::strncmp(app.version, "dsh-agent-v", sizeof("dsh-agent-v")-1) != 0 ||
+        !readRunningImageDigest(*running, record.factory)) return;
+    std::copy(advertised.begin(), advertised.end(), record.agent.begin());
+
+    nvs_handle_t handle;
+    auto error = nvs_open(dsh_shortcut_namespace, NVS_READWRITE, &handle);
+    if (error == ESP_OK) {
+        error = nvs_set_blob(handle, dsh_shortcut_key, &record, sizeof(record));
+        if (error == ESP_OK) error = nvs_commit(handle);
+        nvs_close(handle);
+    }
+    if (error != ESP_OK) ESP_LOGW("DSH Shortcut", "Unable to save App Center shortcut: %s", esp_err_to_name(error));
+}
+
+enum class DshShortcutResult { Selected, SetupRequired, UpdateInProgress, ImageUnavailable };
+
+inline DshShortcutResult selectDshShortcut()
+{
+    if (!availableInactiveAppSlot()) return DshShortcutResult::UpdateInProgress;
+    nvs_handle_t handle;
+    if (nvs_open(dsh_shortcut_namespace, NVS_READONLY, &handle) != ESP_OK) return DshShortcutResult::SetupRequired;
+    DshShortcutRecord record;
+    size_t size = sizeof(record);
+    const auto result = nvs_get_blob(handle, dsh_shortcut_key, &record, &size);
+    nvs_close(handle);
+    ImageDigest factory;
+    const auto* running = esp_ota_get_running_partition();
+    if (result != ESP_OK || size != sizeof(record) || !running ||
+        !readRunningImageDigest(*running, factory) || factory != record.factory) {
+        return DshShortcutResult::SetupRequired;
+    }
+    return selectInstalledApp({record.agent.data(), record.agent.size()}) ?
+        DshShortcutResult::Selected : DshShortcutResult::ImageUnavailable;
+}
+
+} // namespace app_center
