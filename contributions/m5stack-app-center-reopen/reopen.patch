diff --git a/firmware/main/hal/app_center_reopen.h b/firmware/main/hal/app_center_reopen.h
new file mode 100644
index 0000000000000000000000000000000000000000..70a8390529cdd2ac9fc8a193f09969c10898352b
--- /dev/null
+++ b/firmware/main/hal/app_center_reopen.h
@@ -0,0 +1,73 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+
+#include <esp_ota_ops.h>
+#include <array>
+#include <cstdint>
+#include <optional>
+#include <string_view>
+
+namespace app_center {
+
+using ImageDigest = std::array<uint8_t, 32>;
+
+inline std::optional<ImageDigest> parseReopenDigest(std::string_view text)
+{
+    ImageDigest digest;
+    if (text.size() != 2 * digest.size()) return std::nullopt;
+    const auto digit = [](char c) {
+        if (c >= '0' && c <= '9') return c - '0';
+        if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+        return -1;
+    };
+    for (size_t i = 0; i < digest.size(); ++i) {
+        const auto high = digit(text[2 * i]);
+        const auto low = digit(text[2 * i + 1]);
+        if (high < 0 || low < 0) return std::nullopt;
+        digest[i] = static_cast<uint8_t>(16 * high + low);
+    }
+    return digest;
+}
+
+inline bool confirmedAppIsSelected(const esp_partition_t* running)
+{
+    const auto* selected = esp_ota_get_boot_partition();
+    esp_ota_img_states_t state;
+    return running && selected && running->address == selected->address &&
+           esp_ota_get_state_partition(running, &state) == ESP_OK && state == ESP_OTA_IMG_VALID;
+}
+
+inline const esp_partition_t* availableInactiveAppSlot()
+{
+    const auto* running = esp_ota_get_running_partition();
+    if (esp_ota_get_app_partition_count() != 2 || !confirmedAppIsSelected(running) ||
+        (running->subtype != ESP_PARTITION_SUBTYPE_APP_OTA_0 && running->subtype != ESP_PARTITION_SUBTYPE_APP_OTA_1)) {
+        return nullptr;
+    }
+    const auto* target = esp_ota_get_next_update_partition(running);
+    return target && target->address != running->address && target->subtype == (running->subtype ^ 1) ? target : nullptr;
+}
+
+inline const esp_partition_t* installedAppToReopen(std::string_view imageSha256)
+{
+    const auto expected = parseReopenDigest(imageSha256);
+    if (!expected) return nullptr;
+    const auto* target = availableInactiveAppSlot();
+    esp_ota_img_states_t state;
+    ImageDigest digest;
+    if (!target || esp_ota_get_state_partition(target, &state) != ESP_OK || state != ESP_OTA_IMG_ABORTED ||
+        esp_partition_get_sha256(target, digest.data()) != ESP_OK || digest != *expected) {
+        return nullptr;
+    }
+    return availableInactiveAppSlot() == target ? target : nullptr;
+}
+
+// The App Center and Setup update actions run on the same application task.
+// Call only from that task, with no OTA writer active.
+inline bool selectInstalledApp(std::string_view imageSha256)
+{
+    const auto* target = installedAppToReopen(imageSha256);
+    return target && esp_ota_set_boot_partition(target) == ESP_OK;
+}
+
+}  // namespace app_center
